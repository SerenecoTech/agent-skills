{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-compound-bash.sh\"",
            "timeout": 5,
            "statusMessage": "Checking for compound bash commands"
          }
        ]
      }
    ]
  }
}
