{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/write-guard.sh\"",
            "timeout": 3,
            "statusMessage": "Checking write target and content"
          }
        ]
      },
      {
        "matcher": "Read|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/read-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking file for credentials"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.sh\"",
            "timeout": 3,
            "statusMessage": "Checking command safety"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/toolchain-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Checking toolchain match"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/env-expansion-guard.sh\"",
            "timeout": 3,
            "statusMessage": "Checking credential variable use"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rm-guard.sh\"",
            "timeout": 3,
            "statusMessage": "Checking rm target"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/github-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking GitHub merge and branch safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|NotebookRead|WebFetch|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/output-alarm.sh\"",
            "timeout": 5,
            "statusMessage": "Checking output for credentials"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/git-permission.sh\"",
            "timeout": 2,
            "statusMessage": "Checking git operation"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/github-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch deletion policy"
          }
        ]
      }
    ]
  }
}
